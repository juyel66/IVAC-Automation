{
  "manifest_version": 3,
  "name": "IVAC Booking Assistant",
  "version": "1.0.0",
  "description": "Production-minded Chrome Extension assistant for IVAC Bangladesh appointment booking workflow.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://appointment.ivacbd.com/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "IVAC Booking Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://appointment.ivacbd.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "assets/*"
      ],
      "matches": [
        "https://appointment.ivacbd.com/*"
      ]
    }
  ]
}
